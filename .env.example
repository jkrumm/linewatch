# Copied to .env by `make up` (which also injects LINEWATCH_TOKEN from
# ~/.config/linewatch/token — see the Makefile). Every value below has a sane
# default in src/config.ts; only set what you need to override.

# Bearer token required on POST /api/probes and POST /api/speedtests/run.
# Never hardcode a real value here — `make up` and `make collector-setup`
# both generate/read it from ~/.config/linewatch/token so the API container
# and the native collector always agree.
LINEWATCH_TOKEN=

# API port (also the port docker-compose publishes).
# LINEWATCH_PORT=7731

# SQLite file path, relative to the process cwd (/app in the container).
# LINEWATCH_DB=./data/linewatch.db

# Probe cadence (docs/DESIGN.md "Cadence").
# LINEWATCH_PROBE_CYCLE_S=30
# LINEWATCH_PING_COUNT=20
# LINEWATCH_PING_INTERVAL_S=0.2

# Collector-side link sampler. The interface is only the fallback used until a
# cycle reports a default route — after that the routing table wins. Sampling
# faster than 1 Hz buys resolution at 1.71 ms of spawn per sample.
# LINEWATCH_LINK_IFACE=en0
# LINEWATCH_LINK_SAMPLE_MS=1000

# Collector-side Wi-Fi sampler — an alternate radio path currently attached,
# not "the standby path" (the configured next hop above Wi-Fi on this host is a
# cellular hotspot). Sampled every 10th cycle because `system_profiler
# SPAirPortDataType` costs ~4.8 s; the ping is bound to the interface and goes
# to the first `wan`-scoped target unless overridden.
# LINEWATCH_WIFI_IFACE=en1
# LINEWATCH_WIFI_EVERY_N_CYCLES=10
# LINEWATCH_WIFI_PING_TARGET=1.1.1.1

# Collector-side log bound. The collector rotates its own launchd log in place
# at 8 MiB, keeping one previous generation (≤16 MiB, ~21-42 days at the
# measured ~400 KB/day). LINEWATCH_LOG_PATH must equal the plist's
# StandardOutPath — the LaunchAgent sets it; nothing rotates if it does not
# match the file fd 1 is actually open on. 0 disables rotation outright.
# (no tilde expansion — an absolute path, exactly as the plist renders it)
# LINEWATCH_LOG_PATH=/Users/<you>/Library/Logs/linewatch-collector.log
# LINEWATCH_LOG_MAX_BYTES=8388608

# croner pattern for the (jittered) hourly speed test.
# LINEWATCH_SPEEDTEST_CRON=0 * * * *

# Override the target set: comma-separated "name:addr:scope" entries.
# LINEWATCH_TARGETS=gateway:192.168.1.1:gateway,cloudflare:1.1.1.1:wan,google:8.8.8.8:wan,quad9:9.9.9.9:wan
