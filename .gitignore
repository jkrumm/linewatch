node_modules

# Vestigial since the database left the repo (2026-07-30 into a Docker volume, 2026-11-14
# onto ~/.local/share/linewatch) — holds at most the old MOVED-TO-DOCKER-VOLUME marker (docs/storage.md). Nothing here is
# the record: src/db/client.ts refuses a host-side open of this directory by
# path, so the guard survives a fresh clone that has no marker.
data
# Throwaway database for a native `bun run dev` / `bun run start`. Never the
# record — that lives at ~/.local/share/linewatch/linewatch.db.
.dev-data
# `make db-backup` snapshots, restore archives and the db-move working files.
backups
collector/spool.jsonl
# The watchdog's two spools. Separate from each other because they drain over
# different networks — events against localhost, notifications across the WAN
# that is down when there is something to say — and both are runtime state.
collector/watchdog-events.jsonl
collector/watchdog-notify.jsonl
web/dist
*.log

# Recovery snapshots an agent session can leave behind: duplicate copies of src/
# and web/src/, invisible to both gates (bun test skips dot-directories, tsconfig
# does not include it) and one `git add -A` from being committed as a second,
# stale copy of the whole codebase.
.recover

# Carries the real bearer token (rendered by `make up`) — never commit it.
.env

# Wave evidence: raw screenshots stay local, the index in docs/waves/evidence/*.md is committed.
docs/waves/evidence/raw/
