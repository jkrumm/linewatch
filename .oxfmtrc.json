{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": false,
  "ignorePatterns": [
    "drizzle/**",
    "docs/**",
    "**/*.md",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "web/.claude/**",
    "web/.basalt/**",
    "web/dist/**",
    "web/src/routeTree.gen.ts"
  ]
}
