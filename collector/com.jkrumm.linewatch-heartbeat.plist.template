<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.linewatch-heartbeat</string>
  <!-- Pushes one Uptime Kuma heartbeat per run (collector/heartbeat.ts). Kuma
       is on the homelab's WAN and the Tailscale ACL has no tag:homelab ->
       tag:mac grant, so it cannot probe this line; the mini reports on itself
       and a missed heartbeat IS the outage alert.

       StartInterval + RunAtLoad, NOT KeepAlive: this is a one-shot, not a
       daemon. Each run is independent, so a crash or a wedged push costs one
       heartbeat rather than leaving a dead daemon and a monitor that is green
       purely because nothing is left to contradict it. The 60 s cadence sits
       four heartbeats inside the monitor's 240 s interval, so a single skipped
       run cannot page — the same margin the other MacMini push monitors keep.

       Runs under jobrun with a deadline a little under the cadence. launchd
       never starts a second instance of a running job, so without it one hung
       call (2026-11-06: a 28 h freeze in another pusher) silences this monitor
       and nothing restarts it. jobrun kills the process group at 45 s (TERM,
       then KILL after 10 s) and records the run for `jobs-grade`; a killed run
       pushes nothing, which is correct, because silence is what Kuma alerts on.
       Hangs the run can name (API, push) are already bounded in heartbeat.ts
       and push `down` with the reason. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.linewatch-heartbeat</string>
    <string>--owner</string><string>linewatch</string>
    <string>--every</string><string>60</string>
    <string>--timeout</string><string>45</string>
    <string>--</string>
    <string>__REPO_DIR__/collector/run-agent.sh</string>
    <string>__REPO_DIR__/collector/heartbeat.ts</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LINEWATCH_BUN</key><string>__BUN__</string>
    <!-- launchd starts this with no shell profile at all. jobrun is a
         `#!/usr/bin/env bun` script, so PATH needs bun's directory and
         ~/.local/bin (where jobrun lives) as well as the system dirs. -->
    <key>PATH</key><string>__BUN_DIR__:__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Must stay identical to StandardOutPath below: heartbeat.ts bounds this
         file by truncating it in place. Under jobrun fd 1 is a pipe, so
         collector/log-rotate.ts cannot prove the path itself; the flag below
         asserts it instead. A drift costs the size bound, never the log. -->
    <key>LINEWATCH_HEARTBEAT_LOG_PATH</key><string>__HOME__/Library/Logs/linewatch-heartbeat.log</string>
    <key>LINEWATCH_HEARTBEAT_LOG_VIA_JOBRUN</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/linewatch-heartbeat.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/linewatch-heartbeat.log</string>
</dict>
</plist>
