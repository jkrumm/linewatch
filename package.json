{
  "name": "linewatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "LINEWATCH_DB=${LINEWATCH_DB:-./.dev-data/linewatch.db} bun run src/index.ts",
    "dev": "LINEWATCH_DB=${LINEWATCH_DB:-./.dev-data/linewatch.db} bun run --hot src/index.ts",
    "collector": "bun run collector/probe.ts",
    "lint": "oxlint --type-aware src collector scripts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "croner": "11.0.0",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "drizzle-kit": "0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2"
  }
}
