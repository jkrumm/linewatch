{
  "name": "linewatch-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx kill-port 7732 && vite --port 7732 --strictPort",
    "build": "vite build",
    "lint": "oxlint . && basalt-ui check-theme",
    "preview": "vite preview --port 7732 --strictPort",
    "typecheck": "tsr generate && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/hubot-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/modals": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@mantine/spotlight": "^9.7.4",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "basalt-ui": "2.29.0",
    "d3-scale": "4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^5",
    "vite": "^8.3.5"
  },
  "basalt": {
    "roots": [
      "src"
    ],
    "shell": false
  }
}
